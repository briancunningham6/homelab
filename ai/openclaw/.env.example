# OpenClaw Environment Variables
# Copy to ~/.openclaw/.env and fill in actual values.

# ── LLM Provider ────────────────────────────────────────────────────────────
# Anthropic API key (required if not using Claude Pro/Max subscription)
ANTHROPIC_API_KEY=sk-ant-CHANGEME

# Optional: OpenAI API key (if using OpenAI models as fallback)
# OPENAI_API_KEY=sk-CHANGEME

# ── Gateway Auth ────────────────────────────────────────────────────────────
# Token for the Control UI dashboard (http://localhost:18789)
OPENCLAW_GATEWAY_TOKEN=changeme-generate-a-random-token

# Token for inbound webhooks (POST /hooks/agent)
OPENCLAW_HOOKS_TOKEN=changeme-generate-a-random-token

# ── Platform Integration ────────────────────────────────────────────────────
# Immich API key (for homelab-immich skill)
# Generate at: http://immich.home → User Settings → API Keys
IMMICH_API_KEY=changeme

# ── Optional: Telegram ──────────────────────────────────────────────────────
# Bot token from @BotFather (only if using Telegram channel)
# TELEGRAM_BOT_TOKEN=123456:ABC-...
