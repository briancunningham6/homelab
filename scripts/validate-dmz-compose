#!/usr/bin/env bash
# validate-dmz-compose — Validate DMZ compose files against syntax + security policy
# Usage: validate-dmz-compose [app-name|all]

set -euo pipefail

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

HOMELAB_DIR="${HOMELAB_DIR:-$HOME/homelab}"
DMZ_DIR="${HOMELAB_DIR}/dmz"
TARGET="${1:-all}"
ERRORS=0

# Comma-separated app names that are allowed to use host networking.
DMZ_HOST_NETWORK_ALLOWLIST="${DMZ_HOST_NETWORK_ALLOWLIST:-}"

info() { echo -e "${GREEN}[validate-dmz]${NC} $*"; }
warn() { echo -e "${YELLOW}[validate-dmz]${NC} $*"; }
fail() { echo -e "${RED}[validate-dmz]${NC} $*"; }

trim_spaces() {
  echo "$1" | tr -d '[:space:]'
}

app_is_host_network_allowlisted() {
  local app="$1"
  local allowlist
  allowlist="$(trim_spaces "$DMZ_HOST_NETWORK_ALLOWLIST")"
  if [ -z "$allowlist" ]; then
    return 1
  fi

  local item
  IFS=',' read -r -a items <<< "$allowlist"
  for item in "${items[@]}"; do
    if [ "$item" = "$app" ]; then
      return 0
    fi
  done
  return 1
}

list_compose_files() {
  if [ "$TARGET" = "all" ]; then
    find "$DMZ_DIR" -mindepth 2 -maxdepth 2 -name "compose.yml" | sort
    return 0
  fi

  if [ -f "$DMZ_DIR/$TARGET/compose.yml" ]; then
    echo "$DMZ_DIR/$TARGET/compose.yml"
    return 0
  fi

  fail "DMZ app '$TARGET' not found at $DMZ_DIR/$TARGET/compose.yml"
  return 1
}

count_services() {
  local compose_file="$1"
  awk '
    /^services:[[:space:]]*$/ { in_services=1; next }
    in_services && /^[^[:space:]]/ { in_services=0 }
    in_services && /^  [a-zA-Z0-9_-]+:[[:space:]]*$/ { count++ }
    END { print count + 0 }
  ' "$compose_file"
}

count_service_healthchecks() {
  local compose_file="$1"
  awk '
    /^services:[[:space:]]*$/ { in_services=1; next }
    in_services && /^[^[:space:]]/ { in_services=0 }
    in_services && /^    healthcheck:[[:space:]]*$/ { count++ }
    END { print count + 0 }
  ' "$compose_file"
}

count_service_users() {
  local compose_file="$1"
  awk '
    /^services:[[:space:]]*$/ { in_services=1; next }
    in_services && /^[^[:space:]]/ { in_services=0 }
    in_services && /^    user:[[:space:]]*.+$/ { count++ }
    END { print count + 0 }
  ' "$compose_file"
}

count_non_loopback_ports() {
  local compose_file="$1"
  awk '
    {
      line=$0
      trimmed=line
      sub(/^[[:space:]]*/, "", trimmed)
      indent=length(line) - length(trimmed)
    }
    /^[[:space:]]*ports:[[:space:]]*$/ {
      in_ports=1
      ports_indent=indent
      next
    }
    in_ports && indent <= ports_indent && $0 !~ /^[[:space:]]*$/ {
      in_ports=0
    }
    in_ports && /^[[:space:]]*-[[:space:]]*[^#]+$/ {
      spec=$0
      sub(/^[[:space:]]*-[[:space:]]*/, "", spec)
      gsub(/"/, "", spec)
      gsub(/'\''/, "", spec)
      gsub(/[[:space:]]+$/, "", spec)

      # Port publishing must bind to loopback only.
      if (spec !~ /^127\.0\.0\.1:/ && spec !~ /^\[::1\]:/) {
        bad++
      }
    }
    END { print bad + 0 }
  ' "$compose_file"
}

validate_one_compose() {
  local compose_file="$1"
  local app
  local rel
  local service_count
  local healthcheck_count
  local user_count
  local non_loopback_ports
  local file_errors=0

  app="$(basename "$(dirname "$compose_file")")"
  rel="${compose_file#$HOMELAB_DIR/}"

  # Syntax validation first (resolved config and env interpolation checks).
  if ! (cd "$(dirname "$compose_file")" && docker compose config --no-interpolate > /dev/null 2>&1); then
    fail "✗ ${app} — invalid compose syntax (${rel})"
    (cd "$(dirname "$compose_file")" && docker compose config --no-interpolate 2>&1 | head -5) | sed 's/^/    /'
    return 1
  fi

  # DMZ apps must be explicitly tagged.
  if ! rg -q 'com\.homelab\.zone=dmz' "$compose_file"; then
    fail "✗ ${app} — missing required label com.homelab.zone=dmz (${rel})"
    file_errors=$((file_errors + 1))
  fi

  # Host network mode is blocked unless explicitly allowlisted.
  if rg -q '^[[:space:]]*network_mode:[[:space:]]*host([[:space:]]|$)' "$compose_file"; then
    if ! app_is_host_network_allowlisted "$app"; then
      fail "✗ ${app} — network_mode: host is blocked by policy (${rel})"
      file_errors=$((file_errors + 1))
    else
      warn "• ${app} uses host networking (allowlisted)"
    fi
  fi

  # Privileged containers are never allowed in DMZ apps.
  if rg -q '^[[:space:]]*privileged:[[:space:]]*true([[:space:]]|$)' "$compose_file"; then
    fail "✗ ${app} — privileged containers are not allowed (${rel})"
    file_errors=$((file_errors + 1))
  fi

  # Docker socket mount would break isolation guarantees.
  if rg -q '/var/run/docker\.sock' "$compose_file"; then
    fail "✗ ${app} — docker socket mount is not allowed (${rel})"
    file_errors=$((file_errors + 1))
  fi

  # Force explicit non-root user declaration for each service.
  service_count="$(count_services "$compose_file")"
  user_count="$(count_service_users "$compose_file")"
  if [ "$service_count" -gt 0 ] && [ "$user_count" -lt "$service_count" ]; then
    fail "✗ ${app} — every service must declare user: (found ${user_count}/${service_count}) (${rel})"
    file_errors=$((file_errors + 1))
  fi

  # Every DMZ service must declare a healthcheck.
  healthcheck_count="$(count_service_healthchecks "$compose_file")"
  if [ "$service_count" -gt 0 ] && [ "$healthcheck_count" -lt "$service_count" ]; then
    fail "✗ ${app} — every service must declare healthcheck: (found ${healthcheck_count}/${service_count}) (${rel})"
    file_errors=$((file_errors + 1))
  fi

  # Any published ports must be loopback-only (public traffic enters via DMZ proxy).
  non_loopback_ports="$(count_non_loopback_ports "$compose_file")"
  if [ "$non_loopback_ports" -gt 0 ]; then
    fail "✗ ${app} — found ${non_loopback_ports} non-loopback port mapping(s) (${rel})"
    file_errors=$((file_errors + 1))
  fi

  if [ "$file_errors" -eq 0 ]; then
    info "✓ ${app} (${rel})"
    return 0
  fi

  return 1
}

main() {
  local compose_file
  local compose_list

  if [ ! -d "$DMZ_DIR" ]; then
    fail "DMZ directory not found: $DMZ_DIR"
    exit 1
  fi

  echo -e "${BOLD}Validating DMZ compose files in ${DMZ_DIR}...${NC}"
  echo ""

  compose_list="$(list_compose_files || true)"
  if [ -z "$compose_list" ]; then
    fail "No DMZ compose files found."
    exit 1
  fi

  while IFS= read -r compose_file; do
    if [ -z "$compose_file" ]; then
      continue
    fi
    if ! validate_one_compose "$compose_file"; then
      ERRORS=$((ERRORS + 1))
    fi
  done <<< "$compose_list"

  echo ""
  if [ "$ERRORS" -eq 0 ]; then
    echo -e "${GREEN}${BOLD}DMZ compose validation passed.${NC}"
  else
    echo -e "${RED}${BOLD}${ERRORS} DMZ compose file(s) failed validation.${NC}"
    exit 1
  fi
}

main "$@"
