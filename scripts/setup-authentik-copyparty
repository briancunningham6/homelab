#!/usr/bin/env bash
# setup-authentik-copyparty — Wire Copyparty with Authentik via a Proxy Provider
#
# Prerequisites:
#   1. Both stacks running (platform-up)
#   2. AUTHENTIK_BOOTSTRAP_TOKEN set in platform/authentik/.env
#      Generate with: openssl rand -hex 32
#      Add to .env as: AUTHENTIK_BOOTSTRAP_TOKEN=<value>
#      Restart authentik: docker compose -f platform/authentik/compose.yml up -d
#
# What this script does:
#   - Creates groups: copyparty-admin, copyparty-user
#   - Creates an Authentik Proxy Provider (forward-auth mode) for copyparty.home
#   - Creates the Authentik application bound to that provider
#   - Binds groups to the application
#
# Note: This uses a Proxy Provider (not OAuth2/OIDC) — no Client ID or Secret
# is generated. Authentication is handled at the Caddy layer via forward_auth.
# The Authentik outpost is the built-in embedded outpost (no extra deployment).
#
# Usage:
#   HOMELAB_DIR=~/dev/homelab scripts/setup-authentik-copyparty
#   AUTHENTIK_TOKEN=<token> scripts/setup-authentik-copyparty   # override token

set -euo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

HOMELAB_DIR="${HOMELAB_DIR:-$HOME/homelab}"
AUTHENTIK_URL="http://localhost:80"
AUTHENTIK_HOST="login.home"

info()  { echo -e "${GREEN}✓${NC} $*"; }
warn()  { echo -e "${YELLOW}⚠${NC} $*"; }
err()   { echo -e "${RED}✗${NC} $*"; exit 1; }
step()  { echo -e "\n${BOLD}── $* ──${NC}"; }

# ── Resolve API token ──────────────────────────────────────────────────────────

if [ -n "${AUTHENTIK_TOKEN:-}" ]; then
  TOKEN="$AUTHENTIK_TOKEN"
else
  ENV_FILE="$HOMELAB_DIR/platform/authentik/.env"
  if [ ! -f "$ENV_FILE" ]; then
    err "Cannot find $ENV_FILE. Set AUTHENTIK_TOKEN= or populate the .env file."
  fi
  TOKEN=$(grep '^AUTHENTIK_BOOTSTRAP_TOKEN=' "$ENV_FILE" | cut -d= -f2- | tr -d '"' | tr -d "'")
  if [ -z "$TOKEN" ]; then
    err "AUTHENTIK_BOOTSTRAP_TOKEN is not set in $ENV_FILE.
    Generate one with: openssl rand -hex 32
    Add it to platform/authentik/.env and restart:
      docker compose -f platform/authentik/compose.yml up -d"
  fi
fi

HEADERS=(-H "Authorization: Bearer $TOKEN" -H "Content-Type: application/json" -H "Host: $AUTHENTIK_HOST")

# ── Helper: Authentik API call ─────────────────────────────────────────────────

ak_api() {
  local method="$1"
  local path="$2"
  local body="${3:-}"
  local http_code resp_body tmp_file

  tmp_file=$(mktemp)

  if [ -n "$body" ]; then
    http_code=$(curl -s -o "$tmp_file" -w "%{http_code}" -X "$method" "${HEADERS[@]}" \
      -d "$body" "$AUTHENTIK_URL/api/v3/$path")
  else
    http_code=$(curl -s -o "$tmp_file" -w "%{http_code}" -X "$method" "${HEADERS[@]}" \
      "$AUTHENTIK_URL/api/v3/$path")
  fi

  resp_body=$(cat "$tmp_file")
  rm -f "$tmp_file"

  if [ "$http_code" -lt 200 ] || [ "$http_code" -ge 300 ]; then
    echo "API error $http_code on $method /api/v3/$path: $resp_body" >&2
    return 1
  fi
  echo "$resp_body"
}

# ── Check connectivity ─────────────────────────────────────────────────────────

step "Checking connectivity"
STATUS=$(curl -s -o /dev/null -w "%{http_code}" --max-time 5 \
  "${HEADERS[@]}" "$AUTHENTIK_URL/api/v3/core/users/me/")
if [ "$STATUS" != "200" ]; then
  err "Cannot reach Authentik API (HTTP $STATUS). Is the stack running and is AUTHENTIK_BOOTSTRAP_TOKEN valid?"
fi
info "Authentik API reachable"

# ── Get flow UUIDs ─────────────────────────────────────────────────────────────

step "Resolving flows"
AUTH_FLOW_SLUG="default-authentication-flow"
AUTHZ_FLOW_SLUG="default-provider-authorization-implicit-consent"
INVAL_FLOW_SLUG="default-provider-invalidation-flow"

AUTH_FLOW_PK=$(ak_api GET "flows/instances/?slug=$AUTH_FLOW_SLUG" | \
  python3 -c "import sys,json; r=json.load(sys.stdin); print(r['results'][0]['pk'])")
info "Auth flow: $AUTH_FLOW_SLUG ($AUTH_FLOW_PK)"

AUTHZ_FLOW_PK=$(ak_api GET "flows/instances/?slug=$AUTHZ_FLOW_SLUG" | \
  python3 -c "import sys,json; r=json.load(sys.stdin); print(r['results'][0]['pk'])")
info "Authorization flow: $AUTHZ_FLOW_SLUG ($AUTHZ_FLOW_PK)"

INVAL_FLOW_PK=$(ak_api GET "flows/instances/?slug=$INVAL_FLOW_SLUG" | \
  python3 -c "import sys,json; r=json.load(sys.stdin); print(r['results'][0]['pk'])")
info "Invalidation flow: $INVAL_FLOW_SLUG ($INVAL_FLOW_PK)"

# ── Create groups ──────────────────────────────────────────────────────────────

step "Creating groups"
for GROUP in "copyparty-admin" "copyparty-user"; do
  EXISTING=$(ak_api GET "core/groups/?name=$GROUP" | \
    python3 -c "import sys,json; r=json.load(sys.stdin); print(r['pagination']['count'])")
  if [ "$EXISTING" -gt 0 ]; then
    warn "Group '$GROUP' already exists — skipping"
  else
    ak_api POST "core/groups/" "{\"name\": \"$GROUP\", \"is_superuser\": false}" > /dev/null
    info "Created group: $GROUP"
  fi
done

# ── Create Proxy Provider ──────────────────────────────────────────────────────

step "Creating Proxy Provider for Copyparty (forward-auth mode)"
EXISTING_PROVIDER=$(ak_api GET "providers/proxy/?name=Copyparty" | \
  python3 -c "import sys,json; r=json.load(sys.stdin); print(r['pagination']['count'])")

if [ "$EXISTING_PROVIDER" -gt 0 ]; then
  warn "Provider 'Copyparty' already exists — fetching PK"
  PROVIDER_PK=$(ak_api GET "providers/proxy/?name=Copyparty" | \
    python3 -c "import sys,json; r=json.load(sys.stdin); print(r['results'][0]['pk'])")
else
  PROVIDER_BODY=$(python3 - <<PYEOF
import json
print(json.dumps({
  "name": "Copyparty",
  "authorization_flow": "$AUTHZ_FLOW_PK",
  "authentication_flow": "$AUTH_FLOW_PK",
  "invalidation_flow": "$INVAL_FLOW_PK",
  "mode": "forward_single",
  "external_host": "http://copyparty.home",
  "cookie_domain": "home",
  "access_token_validity": "hours=24",
  "token_validity": "days=30"
}))
PYEOF
)
  PROVIDER_PK=$(ak_api POST "providers/proxy/" "$PROVIDER_BODY" | \
    python3 -c "import sys,json; p=json.load(sys.stdin); print(p['pk'])")
  info "Proxy provider created (PK: $PROVIDER_PK)"
fi

# ── Create Application ─────────────────────────────────────────────────────────

step "Creating Authentik application"
EXISTING_APP=$(ak_api GET "core/applications/?slug=copyparty" | \
  python3 -c "import sys,json; r=json.load(sys.stdin); print(r['pagination']['count'])")

if [ "$EXISTING_APP" -gt 0 ]; then
  warn "Application 'copyparty' already exists — skipping"
else
  APP_BODY=$(python3 - <<PYEOF
import json
print(json.dumps({
  "name": "Copyparty",
  "slug": "copyparty",
  "provider": $PROVIDER_PK,
  "meta_description": "Self-hosted file server — per-user storage and shared family folder",
  "policy_engine_mode": "any"
}))
PYEOF
)
  ak_api POST "core/applications/" "$APP_BODY" > /dev/null
  info "Application created"
fi

# ── Bind groups to application ─────────────────────────────────────────────────

step "Binding access groups to application"
APP_OBJ_PK=$(ak_api GET "core/applications/?slug=copyparty" | \
  python3 -c "import sys,json; r=json.load(sys.stdin); print(r['results'][0]['pk'])")

for GROUP in "copyparty-admin" "copyparty-user"; do
  GROUP_PK=$(ak_api GET "core/groups/?name=$GROUP" | \
    python3 -c "import sys,json; r=json.load(sys.stdin); print(r['results'][0]['pk'])")

  EXISTING_BINDING=$(ak_api GET "policies/bindings/?target=$APP_OBJ_PK&group=$GROUP_PK" | \
    python3 -c "import sys,json; r=json.load(sys.stdin); print(r['pagination']['count'])")
  if [ "$EXISTING_BINDING" -gt 0 ]; then
    warn "Group '$GROUP' already bound to application — skipping"
  else
    BINDING_BODY=$(python3 - <<PYEOF
import json
print(json.dumps({
  "target": "$APP_OBJ_PK",
  "group": "$GROUP_PK",
  "enabled": True,
  "order": 0,
  "timeout": 30,
  "failure_result": False
}))
PYEOF
)
    ak_api POST "policies/bindings/" "$BINDING_BODY" > /dev/null
    info "Bound group '$GROUP' to Copyparty application"
  fi
done

# ── Output ─────────────────────────────────────────────────────────────────────

echo ""
echo -e "${BOLD}╔══════════════════════════════════════════════╗${NC}"
echo -e "${BOLD}║     Authentik → Copyparty Setup Complete      ║${NC}"
echo -e "${BOLD}╚══════════════════════════════════════════════╝${NC}"
echo ""
echo -e "${BOLD}No credentials to copy — auth is handled at the Caddy layer.${NC}"
echo ""
echo -e "${YELLOW}Next steps:${NC}"
echo -e "  1. Generate a shared secret and set it in both:"
echo -e "     apps/copyparty/.env  →  CP_SECRET=<value>"
echo -e "     platform/caddy/.env  →  CP_SECRET=<same value>"
echo -e "     (Generate with: openssl rand -hex 32)"
echo -e "  2. Restart Caddy to pick up CP_SECRET:"
echo -e "     docker compose -f platform/caddy/compose.yml up -d"
echo -e "     docker exec caddy caddy reload --config /etc/caddy/Caddyfile"
echo -e "  3. Start Copyparty:"
echo -e "     docker compose -f apps/copyparty/compose.yml up -d"
echo -e "  4. Navigate to http://copyparty.home"
echo -e "     You will be redirected to Authentik login"
echo ""
echo -e "${YELLOW}To grant a user access to Copyparty:${NC}"
echo -e "  In Authentik → Directory → Groups → copyparty-user → add the user"
echo -e "  (or copyparty-admin for admin access)"
echo ""
