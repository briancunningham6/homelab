#!/usr/bin/env bash
# app-backup — Backup an app's data directory
# Usage: app-backup <app-name>

set -euo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

HOMELAB_DIR="${HOMELAB_DIR:-$HOME/homelab}"
LOCAL_BACKUP_DIR="${LOCAL_BACKUP_DIR:-$HOMELAB_DIR/backups/local}"

info()  { echo -e "${GREEN}[app-backup]${NC} $*"; }
warn()  { echo -e "${YELLOW}[app-backup]${NC} $*"; }
error() { echo -e "${RED}[app-backup]${NC} $*" >&2; }

if [ $# -lt 1 ]; then
  echo "Usage: app-backup <app-name>"
  exit 1
fi

APP="$1"

resolve_path() {
  local name="$1"
  for dir in apps platform ai; do
    if [ -d "$HOMELAB_DIR/$dir/$name" ]; then
      echo "$HOMELAB_DIR/$dir/$name"
      return 0
    fi
  done
  return 1
}

APP_DIR=$(resolve_path "$APP") || {
  error "App '$APP' not found in apps/, platform/, or ai/"
  exit 1
}

DATA_DIR="$APP_DIR/data"
if [ ! -d "$DATA_DIR" ]; then
  warn "No data/ directory found in $APP_DIR — nothing to backup"
  exit 0
fi

# Check if Restic is configured
RESTIC_ENV="$APP_DIR/.env"
GLOBAL_BACKUP_CONFIG="$HOMELAB_DIR/backups/restic.env"
RESTIC_CONFIGURED=false

load_restic_env() {
  local envfile="$1"
  if [ -f "$envfile" ]; then
    # shellcheck disable=SC1090
    set -a
    . "$envfile"
    set +a
    if [ -n "${RESTIC_REPOSITORY:-}" ] && [ -n "${RESTIC_PASSWORD:-}" ]; then
      return 0
    fi
  fi
  return 1
}

if load_restic_env "$RESTIC_ENV" || load_restic_env "$GLOBAL_BACKUP_CONFIG"; then
  RESTIC_CONFIGURED=true
fi

if $RESTIC_CONFIGURED; then
  info "Using Restic for backup..."
  export RESTIC_REPOSITORY RESTIC_PASSWORD
  restic backup "$DATA_DIR" --tag "$APP"
  info "Backup complete."
else
  warn "Restic not configured — using local tar backup"
  mkdir -p "$LOCAL_BACKUP_DIR"
  TIMESTAMP=$(date +%Y%m%d-%H%M%S)
  ARCHIVE="$LOCAL_BACKUP_DIR/${APP}-${TIMESTAMP}.tar.gz"
  tar -czf "$ARCHIVE" -C "$APP_DIR" data/
  info "Backup complete: $ARCHIVE"
  info "Archive size: $(du -sh "$ARCHIVE" | cut -f1)"
fi
