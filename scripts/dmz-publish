#!/usr/bin/env bash
# dmz-publish — Push blog content and files to DMZ Pi
# Usage: dmz-publish [blog|files|all]
#
# Workflow:
#   1. Author content locally (Hugo blog in content/blog/, files in content/files/)
#   2. Build Hugo site: cd content/blog && hugo build
#   3. Publish: scripts/dmz-publish

set -euo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

HOMELAB_DIR="${HOMELAB_DIR:-$HOME/homelab}"

# DMZ Pi configuration (via Tailscale)
DMZ_HOST="${DMZ_HOST:-dmz-pi5}"
DMZ_USER="${DMZ_USER:-dmz}"
DMZ_PATH="${DMZ_PATH:-/home/dmz/dmz}"

# Source directories on Mac mini
BLOG_SOURCE="${HOMELAB_DIR}/content/blog/public"
FILES_SOURCE="${HOMELAB_DIR}/content/files"

info()  { echo -e "${GREEN}[dmz-publish]${NC} $*"; }
warn()  { echo -e "${YELLOW}[dmz-publish]${NC} $*"; }
error() { echo -e "${RED}[dmz-publish]${NC} $*" >&2; }

check_connectivity() {
    info "Checking DMZ connectivity via Tailscale..."
    if ! tailscale ping -c 1 "$DMZ_HOST" > /dev/null 2>&1; then
        error "Cannot reach $DMZ_HOST via Tailscale"
        error "Ensure DMZ Pi is online and Tailscale is connected"
        exit 1
    fi
    info "DMZ reachable"
}

publish_blog() {
    info "Publishing blog content to DMZ..."

    if [ ! -d "$BLOG_SOURCE" ]; then
        error "Blog source not found: $BLOG_SOURCE"
        error ""
        error "To create a Hugo blog:"
        error "  mkdir -p content/blog && cd content/blog"
        error "  hugo new site ."
        error "  hugo new posts/hello-world.md"
        error "  hugo build"
        return 1
    fi

    # Count files to sync
    local file_count
    file_count=$(find "$BLOG_SOURCE" -type f | wc -l | tr -d ' ')
    info "Syncing $file_count files..."

    rsync -avz --delete \
        --exclude '.DS_Store' \
        --exclude '*.swp' \
        "$BLOG_SOURCE/" \
        "${DMZ_USER}@${DMZ_HOST}:${DMZ_PATH}/blog/public/"

    info "Blog published successfully"
}

publish_files() {
    info "Publishing shared files to DMZ..."

    if [ ! -d "$FILES_SOURCE" ]; then
        warn "Files source not found: $FILES_SOURCE"
        warn "Create the directory and add files to share:"
        warn "  mkdir -p content/files"
        warn "  cp ~/Documents/file.pdf content/files/"
        return 0
    fi

    # Check if empty
    if [ -z "$(ls -A "$FILES_SOURCE")" ]; then
        warn "Files directory is empty: $FILES_SOURCE"
        return 0
    fi

    # Count files to sync
    local file_count
    file_count=$(find "$FILES_SOURCE" -type f | wc -l | tr -d ' ')
    info "Syncing $file_count files..."

    rsync -avz --delete \
        --exclude '.DS_Store' \
        --exclude '*.swp' \
        "$FILES_SOURCE/" \
        "${DMZ_USER}@${DMZ_HOST}:${DMZ_PATH}/files/public/"

    info "Files published successfully"
}

show_status() {
    info "Checking DMZ service status..."
    ssh "${DMZ_USER}@${DMZ_HOST}" "cd ${DMZ_PATH} && docker compose ps --format 'table {{.Name}}\t{{.Status}}'"
}

show_url() {
    local ts_hostname
    ts_hostname=$(ssh "${DMZ_USER}@${DMZ_HOST}" "tailscale status --self --json" 2>/dev/null | grep -o '"DNSName":"[^"]*' | cut -d'"' -f4 | sed 's/\.$//')

    if [ -n "$ts_hostname" ]; then
        echo ""
        info "Public URLs:"
        info "  Blog:  https://${ts_hostname}/blog/"
        info "  Files: https://${ts_hostname}/files/"
    fi
}

usage() {
    cat << EOF
Usage: dmz-publish [command]

Commands:
    blog        Publish Hugo blog content
    files       Publish shared files
    all         Publish both blog and files (default)
    status      Show DMZ service status

Examples:
    dmz-publish                 # Publish everything
    dmz-publish blog            # Publish blog only
    dmz-publish files           # Publish files only
    dmz-publish status          # Check DMZ status

Environment:
    DMZ_HOST    Tailscale hostname (default: dmz-pi5)
    DMZ_USER    SSH user (default: dmz)
    DMZ_PATH    Remote path (default: /home/dmz/dmz)
EOF
}

main() {
    case "${1:-all}" in
        blog)
            check_connectivity
            publish_blog
            show_url
            ;;
        files)
            check_connectivity
            publish_files
            show_url
            ;;
        all)
            check_connectivity
            publish_blog
            publish_files
            show_url
            ;;
        status)
            check_connectivity
            show_status
            show_url
            ;;
        -h|--help|help)
            usage
            ;;
        *)
            error "Unknown command: $1"
            usage
            exit 1
            ;;
    esac

    echo ""
    info "Done!"
}

main "$@"
