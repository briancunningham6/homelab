#!/usr/bin/env bash
# dr-restore — Disaster Recovery: Restore homelab from backup
#
# This script performs a full or partial restore of the homelab platform
# from a Restic backup. It follows the correct dependency order:
#
#   1. Identity (Authentik) — must be restored first for SSO
#   2. Infrastructure (PostgreSQL, Caddy) — shared services
#   3. Platform (monitoring, dashboard)
#   4. Applications (Immich, Copyparty, Matrix)
#
# CRITICAL: This script should be tested quarterly as part of DR drills.
#
# Usage:
#   dr-restore                     # Interactive full restore
#   dr-restore --list              # List available snapshots
#   dr-restore --service authentik # Restore single service
#   dr-restore --snapshot abc123   # Restore specific snapshot
#   dr-restore --dry-run           # Show what would be restored

set -euo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m'

HOMELAB_DIR="${HOMELAB_DIR:-$HOME/homelab}"
BACKUP_ENV="$HOMELAB_DIR/platform/backup/.env"
LOG_DIR="$HOMELAB_DIR/platform/backup/logs"
TIMESTAMP=$(date +%Y%m%d-%H%M%S)
LOG_FILE="$LOG_DIR/restore-$TIMESTAMP.log"

# ── Helpers ──────────────────────────────────────────────────────────────────

info()  { echo -e "${GREEN}✓${NC} $*" | tee -a "$LOG_FILE"; }
warn()  { echo -e "${YELLOW}⚠${NC} $*" | tee -a "$LOG_FILE"; }
error() { echo -e "${RED}✗${NC} $*" | tee -a "$LOG_FILE" >&2; }
step()  { echo -e "\n${BOLD}── $* ──${NC}" | tee -a "$LOG_FILE"; }
debug() { echo -e "${BLUE}→${NC} $*" >> "$LOG_FILE"; }

confirm() {
  local msg="$1"
  echo -e "${YELLOW}$msg${NC}"
  read -p "Continue? (y/N) " -n 1 -r
  echo
  [[ $REPLY =~ ^[Yy]$ ]]
}

# ── Parse Arguments ──────────────────────────────────────────────────────────

DRY_RUN=false
LIST_SNAPSHOTS=false
SINGLE_SERVICE=""
SNAPSHOT_ID="latest"
SKIP_CONFIRMATION=false

while [[ $# -gt 0 ]]; do
  case $1 in
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    --list)
      LIST_SNAPSHOTS=true
      shift
      ;;
    --service)
      SINGLE_SERVICE="$2"
      shift 2
      ;;
    --snapshot)
      SNAPSHOT_ID="$2"
      shift 2
      ;;
    --yes|-y)
      SKIP_CONFIRMATION=true
      shift
      ;;
    --help|-h)
      echo "Usage: dr-restore [OPTIONS]"
      echo ""
      echo "Disaster Recovery restore from Restic backup."
      echo ""
      echo "Options:"
      echo "  --list              List available snapshots"
      echo "  --service NAME      Restore only the specified service"
      echo "  --snapshot ID       Restore from specific snapshot (default: latest)"
      echo "  --dry-run           Show what would be restored"
      echo "  --yes, -y           Skip confirmation prompts"
      echo "  --help, -h          Show this help"
      echo ""
      echo "Restore order (for full restore):"
      echo "  1. authentik    - Identity provider (SSO)"
      echo "  2. postgres     - Shared database"
      echo "  3. caddy        - Reverse proxy"
      echo "  4. uptime-kuma  - Health monitoring"
      echo "  5. homepage     - Dashboard"
      echo "  6. immich       - Photo library"
      echo "  7. copyparty    - File sharing"
      echo "  8. matrix       - Chat server"
      exit 0
      ;;
    *)
      error "Unknown option: $1"
      exit 1
      ;;
  esac
done

# ── Prerequisites ────────────────────────────────────────────────────────────

mkdir -p "$LOG_DIR"

step "Checking prerequisites"

# Check restic is installed
if ! command -v restic &> /dev/null; then
  error "Restic is not installed. Install with: brew install restic"
  exit 1
fi
info "Restic found"

# Check backup config exists
if [ ! -f "$BACKUP_ENV" ]; then
  error "Backup configuration not found: $BACKUP_ENV"
  echo ""
  echo "If restoring to new hardware, you need:"
  echo "  1. The Restic repository password"
  echo "  2. Access to the backup location (Pi hostname/IP)"
  echo ""
  echo "Create $BACKUP_ENV with:"
  echo "  RESTIC_REPOSITORY=sftp:pi@<tailscale-ip>:/backups/homelab"
  echo "  RESTIC_PASSWORD=<your-password>"
  exit 1
fi

# Load backup environment
set -a
# shellcheck source=/dev/null
source "$BACKUP_ENV"
set +a

export RESTIC_REPOSITORY RESTIC_PASSWORD
info "Repository: $RESTIC_REPOSITORY"

# Verify repository is accessible
if ! restic snapshots --latest 1 > /dev/null 2>&1; then
  error "Cannot access Restic repository"
  echo "Check:"
  echo "  - Network connectivity to backup target"
  echo "  - RESTIC_PASSWORD is correct"
  echo "  - SSH key is configured for SFTP access"
  exit 1
fi
info "Repository accessible"

# ── List Snapshots ───────────────────────────────────────────────────────────

if [ "$LIST_SNAPSHOTS" = true ]; then
  step "Available Snapshots"
  restic snapshots
  exit 0
fi

# ── Service Definitions ──────────────────────────────────────────────────────
# Restore order: Identity first, then platform, then apps

declare -A SERVICES
SERVICES=(
  ["authentik"]="platform/authentik"
  ["postgres"]="platform/postgres"
  ["caddy"]="platform/caddy"
  ["uptime-kuma"]="platform/uptime-kuma"
  ["homepage"]="platform/homepage"
  ["dockge"]="platform/dockge"
  ["immich"]="apps/immich"
  ["copyparty"]="apps/copyparty"
  ["matrix"]="apps/matrix"
  ["openclaw"]="ai/openclaw"
)

# Restore order (identity first, apps last)
RESTORE_ORDER=(
  "authentik"
  "postgres"
  "caddy"
  "uptime-kuma"
  "homepage"
  "dockge"
  "immich"
  "copyparty"
  "matrix"
  "openclaw"
)

# ── Restore Functions ────────────────────────────────────────────────────────

stop_service() {
  local name="$1"
  local path="$2"
  local compose_file="$HOMELAB_DIR/$path/compose.yml"

  if [ -f "$compose_file" ]; then
    debug "Stopping $name"
    docker compose -f "$compose_file" down 2>/dev/null || true
  fi
}

start_service() {
  local name="$1"
  local path="$2"
  local compose_file="$HOMELAB_DIR/$path/compose.yml"

  if [ -f "$compose_file" ]; then
    debug "Starting $name"
    docker compose -f "$compose_file" up -d 2>/dev/null || true
  fi
}

restore_service() {
  local name="$1"
  local path="$2"
  local full_path="$HOMELAB_DIR/$path"

  step "Restoring: $name"
  debug "Target path: $full_path"

  # Find snapshots for this service
  local snapshot_info
  snapshot_info=$(restic snapshots --tag "$name" --json 2>/dev/null | head -1)

  if [ -z "$snapshot_info" ] || [ "$snapshot_info" = "[]" ]; then
    warn "No snapshots found for $name (skipping)"
    return 0
  fi

  # Show available snapshots for this service
  echo "Available snapshots for $name:"
  restic snapshots --tag "$name" --compact

  if [ "$DRY_RUN" = true ]; then
    info "[DRY RUN] Would restore $name from snapshot $SNAPSHOT_ID"
    return 0
  fi

  # Stop the service before restore
  stop_service "$name" "$path"

  # Create backup of current state (if exists)
  if [ -d "$full_path/data" ]; then
    local pre_restore_backup="$full_path/data.pre-restore-$TIMESTAMP"
    warn "Creating pre-restore backup: $pre_restore_backup"
    mv "$full_path/data" "$pre_restore_backup"
  fi

  # Restore from Restic
  info "Restoring from snapshot..."

  local restore_target="/tmp/restic-restore-$$"
  mkdir -p "$restore_target"

  if [ "$SNAPSHOT_ID" = "latest" ]; then
    restic restore latest --tag "$name" --target "$restore_target" 2>&1 | tee -a "$LOG_FILE"
  else
    restic restore "$SNAPSHOT_ID" --target "$restore_target" 2>&1 | tee -a "$LOG_FILE"
  fi

  # Move restored data to correct location
  # Restic preserves full paths, so we need to find and move the data
  local restored_data
  restored_data=$(find "$restore_target" -type d -name "data" | head -1)

  if [ -n "$restored_data" ] && [ -d "$restored_data" ]; then
    mkdir -p "$full_path"
    mv "$restored_data" "$full_path/"
    info "Restored data directory"
  fi

  # Also check for config directory
  local restored_config
  restored_config=$(find "$restore_target" -type d -name "config" | head -1)

  if [ -n "$restored_config" ] && [ -d "$restored_config" ]; then
    mv "$restored_config" "$full_path/"
    info "Restored config directory"
  fi

  # Cleanup
  rm -rf "$restore_target"

  # Run post-restore hooks
  run_post_restore_hooks "$name" "$path"

  # Start the service
  start_service "$name" "$path"

  info "$name restore complete"
}

run_post_restore_hooks() {
  local name="$1"
  local path="$2"
  local full_path="$HOMELAB_DIR/$path"

  debug "Running post-restore hooks for $name"

  case "$name" in
    authentik)
      # Restore database from dump if present
      if [ -f "$full_path/data/authentik-db-dump.sql" ]; then
        info "Restoring Authentik database from dump..."
        sleep 10  # Wait for postgres to start
        docker exec -i authentik-db psql -U authentik authentik < "$full_path/data/authentik-db-dump.sql" 2>/dev/null || true
      fi
      ;;
    postgres)
      # Restore all databases from dump if present
      if [ -f "$full_path/data/postgres-dump.sql" ]; then
        info "Restoring shared PostgreSQL from dump..."
        sleep 10  # Wait for postgres to start
        docker exec -i postgres psql -U postgres < "$full_path/data/postgres-dump.sql" 2>/dev/null || true
      fi
      ;;
    matrix)
      # Restore Matrix database from dump if present
      if [ -f "$full_path/data/matrix-db-dump.sql" ]; then
        info "Restoring Matrix database from dump..."
        sleep 10  # Wait for postgres to start
        docker exec -i matrix-db psql -U synapse synapse < "$full_path/data/matrix-db-dump.sql" 2>/dev/null || true
      fi
      ;;
  esac
}

verify_service() {
  local name="$1"
  local path="$2"
  local compose_file="$HOMELAB_DIR/$path/compose.yml"

  if [ ! -f "$compose_file" ]; then
    return 0
  fi

  debug "Verifying $name"

  # Check containers are running
  local running
  running=$(docker compose -f "$compose_file" ps --format json 2>/dev/null | grep -c '"running"' || echo "0")

  if [ "$running" -gt 0 ]; then
    info "$name: $running container(s) running"
    return 0
  else
    warn "$name: No containers running"
    return 1
  fi
}

# ── Main ─────────────────────────────────────────────────────────────────────

echo ""
echo -e "${BOLD}╔══════════════════════════════════════════════════════════════╗${NC}"
echo -e "${BOLD}║        Homelab Disaster Recovery — $(date '+%Y-%m-%d %H:%M')        ║${NC}"
echo -e "${BOLD}╚══════════════════════════════════════════════════════════════╝${NC}"
echo ""

# Show what we're about to do
if [ -n "$SINGLE_SERVICE" ]; then
  echo -e "${BOLD}Mode:${NC} Single service restore"
  echo -e "${BOLD}Service:${NC} $SINGLE_SERVICE"
else
  echo -e "${BOLD}Mode:${NC} Full platform restore"
  echo -e "${BOLD}Order:${NC} ${RESTORE_ORDER[*]}"
fi
echo -e "${BOLD}Snapshot:${NC} $SNAPSHOT_ID"
echo ""

# Warning for full restore
if [ -z "$SINGLE_SERVICE" ] && [ "$SKIP_CONFIRMATION" = false ] && [ "$DRY_RUN" = false ]; then
  echo -e "${RED}${BOLD}WARNING: Full restore will:${NC}"
  echo "  - Stop ALL running services"
  echo "  - Replace ALL data directories with backup data"
  echo "  - This operation cannot be undone"
  echo ""

  if ! confirm "This is a destructive operation."; then
    echo "Restore cancelled."
    exit 0
  fi
fi

START_TIME=$(date +%s)

if [ -n "$SINGLE_SERVICE" ]; then
  # Single service restore
  if [ -z "${SERVICES[$SINGLE_SERVICE]:-}" ]; then
    error "Unknown service: $SINGLE_SERVICE"
    echo "Available services: ${!SERVICES[*]}"
    exit 1
  fi

  restore_service "$SINGLE_SERVICE" "${SERVICES[$SINGLE_SERVICE]}"
else
  # Full restore in dependency order
  step "Phase 1: Stopping all services"

  # Stop in reverse order (apps first, identity last)
  for ((i=${#RESTORE_ORDER[@]}-1; i>=0; i--)); do
    service="${RESTORE_ORDER[$i]}"
    path="${SERVICES[$service]}"
    if [ -d "$HOMELAB_DIR/$path" ]; then
      stop_service "$service" "$path"
    fi
  done
  info "All services stopped"

  step "Phase 2: Restoring services"

  # Restore in dependency order (identity first, apps last)
  for service in "${RESTORE_ORDER[@]}"; do
    path="${SERVICES[$service]}"
    if [ -d "$HOMELAB_DIR/$path" ] || [ "$DRY_RUN" = true ]; then
      restore_service "$service" "$path"
    fi
  done

  step "Phase 3: Verifying services"

  FAILED_SERVICES=()
  for service in "${RESTORE_ORDER[@]}"; do
    path="${SERVICES[$service]}"
    if [ -d "$HOMELAB_DIR/$path" ]; then
      if ! verify_service "$service" "$path"; then
        FAILED_SERVICES+=("$service")
      fi
    fi
  done
fi

# ── Summary ──────────────────────────────────────────────────────────────────

END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))

step "Restore Summary"

echo ""
info "Duration: ${DURATION}s"
info "Log file: $LOG_FILE"

if [ ${#FAILED_SERVICES[@]} -gt 0 ]; then
  echo ""
  warn "Services requiring attention:"
  for svc in "${FAILED_SERVICES[@]}"; do
    echo "  - $svc"
  done
  echo ""
  echo "Check logs: docker compose -f <service>/compose.yml logs"
fi

echo ""
echo -e "${BOLD}Post-restore checklist:${NC}"
echo "  [ ] Verify Authentik login at http://login.home"
echo "  [ ] Check Homepage dashboard at http://home.home"
echo "  [ ] Test SSO for each application"
echo "  [ ] Verify Uptime Kuma monitors are green"
echo "  [ ] Check application data integrity"
echo ""
echo -e "${BOLD}If issues persist:${NC}"
echo "  1. Check service logs: docker compose logs <service>"
echo "  2. Verify network connectivity"
echo "  3. Check database connections"
echo "  4. Review $LOG_FILE"
echo ""

if [ "$DRY_RUN" = true ]; then
  echo -e "${YELLOW}${BOLD}This was a dry run. No changes were made.${NC}"
else
  echo -e "${GREEN}${BOLD}Restore complete!${NC}"
fi
echo ""
