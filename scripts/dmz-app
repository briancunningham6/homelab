#!/usr/bin/env bash
# dmz-app — Manage DMZ applications on the Raspberry Pi via SSH + Docker Compose
#
# Usage:
#   dmz-app validate [app|all]
#   dmz-app sync [app|all]
#   dmz-app up [app|all]
#   dmz-app down [app|all]
#   dmz-app restart [app|all]
#   dmz-app pull [app|all]
#   dmz-app update [app|all]
#   dmz-app ps [app|all]
#   dmz-app logs <app> [service]

set -euo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
HOMELAB_DIR="${HOMELAB_DIR:-$HOME/homelab}"
DMZ_LOCAL_DIR="${HOMELAB_DIR}/dmz"

DMZ_HOST="${DMZ_HOST:-dmz-pi5}"
DMZ_USER="${DMZ_USER:-dmz}"
DMZ_REMOTE_DIR="${DMZ_REMOTE_DIR:-/home/dmz/homelab/dmz}"
DMZ_PASSWORD="${DMZ_PASSWORD:-}"
DMZ_SKIP_TAILSCALE_PING="${DMZ_SKIP_TAILSCALE_PING:-false}"
DMZ_DEBUG="${DMZ_DEBUG:-false}"

ACTION="${1:-}"
TARGET="${2:-all}"
EXTRA_ARG="${3:-}"

info()  { echo -e "${GREEN}[dmz-app]${NC} $*"; }
warn()  { echo -e "${YELLOW}[dmz-app]${NC} $*"; }
error() { echo -e "${RED}[dmz-app]${NC} $*" >&2; }

usage() {
  cat <<EOF
Usage: dmz-app <action> [app|all] [service]

Actions:
  validate    Run DMZ policy validation only
  sync        Validate + rsync app(s) to DMZ Pi
  up          Validate + sync + docker compose up -d
  down        docker compose down
  restart     docker compose restart
  pull        Validate + sync + docker compose pull
  update      Alias for: pull + up
  ps          Show docker compose status
  logs        Tail logs (requires single app; optional service name)

Environment:
  HOMELAB_DIR      Local repo root (default: \$HOME/homelab)
  DMZ_HOST         DMZ Pi hostname (default: dmz-pi5)
  DMZ_USER         SSH user (default: dmz)
  DMZ_REMOTE_DIR   Remote DMZ app root (default: /home/dmz/homelab/dmz)
  DMZ_PASSWORD     Optional password for sshpass-based auth
  DMZ_SKIP_TAILSCALE_PING  Set to true to skip tailscale ping precheck
EOF
}

require_command() {
  if ! command -v "$1" > /dev/null 2>&1; then
    error "Required command not found: $1"
    exit 1
  fi
}

get_apps() {
  local target="$1"

  if [ "$target" = "all" ]; then
    find "$DMZ_LOCAL_DIR" -mindepth 1 -maxdepth 1 -type d \
      -exec test -f "{}/compose.yml" \; -print \
      | while IFS= read -r dir; do basename "$dir"; done \
      | sort
    return 0
  fi

  if [ ! -f "$DMZ_LOCAL_DIR/$target/compose.yml" ]; then
    error "DMZ app not found: $target ($DMZ_LOCAL_DIR/$target/compose.yml)"
    return 1
  fi

  echo "$target"
}

check_connectivity() {
  local ssh_target="${DMZ_USER}@${DMZ_HOST}"

  if [ "$DMZ_SKIP_TAILSCALE_PING" != "true" ] && command -v tailscale > /dev/null 2>&1; then
    info "Checking DMZ reachability via Tailscale..."
    if ! tailscale ping -c 1 "$DMZ_HOST" > /dev/null 2>&1; then
      error "Cannot reach $DMZ_HOST via Tailscale"
      exit 1
    fi
  fi

  info "Checking SSH connectivity..."
  if [ -n "$DMZ_PASSWORD" ]; then
    require_command sshpass
    if ! sshpass -p "$DMZ_PASSWORD" ssh \
      -n \
      -o StrictHostKeyChecking=accept-new \
      -o ConnectTimeout=5 \
      "$ssh_target" "echo ok" > /dev/null 2>&1; then
      error "SSH connectivity test failed for $ssh_target (password auth)"
      exit 1
    fi
  else
    if ! ssh -n -o BatchMode=yes -o ConnectTimeout=5 "$ssh_target" "echo ok" > /dev/null 2>&1; then
      error "SSH connectivity test failed for $ssh_target (key auth)"
      exit 1
    fi
  fi
}

validate_apps() {
  local target="$1"
  "$SCRIPT_DIR/validate-dmz-compose" "$target"
}

sync_one_app() {
  local app="$1"
  local ssh_target="${DMZ_USER}@${DMZ_HOST}"
  local local_path="${DMZ_LOCAL_DIR}/${app}/"
  local remote_path="${DMZ_REMOTE_DIR}/${app}/"

  info "Syncing ${app} to ${ssh_target}:${remote_path}"
  if [ -n "$DMZ_PASSWORD" ]; then
    require_command sshpass
    sshpass -p "$DMZ_PASSWORD" ssh -n -o StrictHostKeyChecking=accept-new "$ssh_target" "mkdir -p '$remote_path'"
    sshpass -p "$DMZ_PASSWORD" rsync -az --delete \
      -e "ssh -o StrictHostKeyChecking=accept-new" \
      --exclude '.env' \
      --exclude 'data/' \
      --exclude '.git/' \
      --exclude '.DS_Store' \
      "$local_path" "${ssh_target}:${remote_path}"
  else
    ssh -n "$ssh_target" "mkdir -p '$remote_path'"
    rsync -az --delete \
      --exclude '.env' \
      --exclude 'data/' \
      --exclude '.git/' \
      --exclude '.DS_Store' \
      "$local_path" "${ssh_target}:${remote_path}"
  fi
}

run_remote_compose() {
  local app="$1"
  shift
  local ssh_target="${DMZ_USER}@${DMZ_HOST}"
  local remote_app_dir="${DMZ_REMOTE_DIR}/${app}"

  if [ -n "$DMZ_PASSWORD" ]; then
    require_command sshpass
    sshpass -p "$DMZ_PASSWORD" ssh -o StrictHostKeyChecking=accept-new \
      -n \
      "$ssh_target" "cd '$remote_app_dir' && docker compose $*"
  else
    ssh -n "$ssh_target" "cd '$remote_app_dir' && docker compose $*"
  fi
}

run_for_target() {
  local target="$1"
  local callback="$2"
  local apps
  local app

  apps="$(get_apps "$target")"
  if [ "$DMZ_DEBUG" = "true" ]; then
    warn "Resolved app list for target '$target':"
    printf '%s\n' "$apps" | sed 's/^/[dmz-app][debug] /'
  fi
  while IFS= read -r app; do
    [ -z "$app" ] && continue
    "$callback" "$app"
  done <<< "$apps"
}

action_sync() {
  local app="$1"
  sync_one_app "$app"
}

action_up() {
  local app="$1"
  sync_one_app "$app"
  info "Starting ${app} on DMZ Pi..."
  run_remote_compose "$app" "up -d"
}

action_down() {
  local app="$1"
  info "Stopping ${app} on DMZ Pi..."
  run_remote_compose "$app" "down"
}

action_restart() {
  local app="$1"
  info "Restarting ${app} on DMZ Pi..."
  run_remote_compose "$app" "restart"
}

action_pull() {
  local app="$1"
  sync_one_app "$app"
  info "Pulling images for ${app} on DMZ Pi..."
  run_remote_compose "$app" "pull"
}

action_update() {
  local app="$1"
  sync_one_app "$app"
  info "Updating ${app} on DMZ Pi..."
  run_remote_compose "$app" "pull"
  run_remote_compose "$app" "up -d"
}

action_ps() {
  local app="$1"
  info "Status for ${app}:"
  run_remote_compose "$app" "ps"
}

main() {
  require_command ssh
  require_command rsync

  if [ -z "$ACTION" ]; then
    usage
    exit 1
  fi

  case "$ACTION" in
    validate)
      validate_apps "$TARGET"
      ;;

    sync)
      validate_apps "$TARGET"
      check_connectivity
      run_for_target "$TARGET" action_sync
      ;;

    up)
      validate_apps "$TARGET"
      check_connectivity
      run_for_target "$TARGET" action_up
      ;;

    down)
      check_connectivity
      run_for_target "$TARGET" action_down
      ;;

    restart)
      check_connectivity
      run_for_target "$TARGET" action_restart
      ;;

    pull)
      validate_apps "$TARGET"
      check_connectivity
      run_for_target "$TARGET" action_pull
      ;;

    update)
      validate_apps "$TARGET"
      check_connectivity
      run_for_target "$TARGET" action_update
      ;;

    ps)
      check_connectivity
      run_for_target "$TARGET" action_ps
      ;;

    logs)
      if [ "$TARGET" = "all" ]; then
        error "logs requires a specific app name"
        exit 1
      fi
      check_connectivity
      if [ -n "$EXTRA_ARG" ]; then
        run_remote_compose "$TARGET" "logs -f $EXTRA_ARG"
      else
        run_remote_compose "$TARGET" "logs -f"
      fi
      ;;

    -h|--help|help)
      usage
      ;;

    *)
      error "Unknown action: $ACTION"
      usage
      exit 1
      ;;
  esac

  info "Done."
}

main "$@"
