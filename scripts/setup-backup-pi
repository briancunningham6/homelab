#!/usr/bin/env bash
# setup-backup-pi — Configure Raspberry Pi as offsite backup target
#
# This script sets up an SSH-accessible Restic repository on a remote Pi.
# The Pi should be on your Tailscale network for secure access.
#
# Prerequisites:
#   - Raspberry Pi with Raspberry Pi OS (or similar Debian-based)
#   - Pi connected to Tailscale (tailscale up)
#   - SSH access to the Pi
#   - External storage mounted on Pi (recommended: /mnt/backup-drive)
#
# What this script does:
#   1. Installs Restic on the Pi
#   2. Creates backup user and directory structure
#   3. Sets up SSH key authentication
#   4. Initializes the Restic repository
#   5. Configures local backup environment
#
# Usage:
#   setup-backup-pi <pi-hostname-or-ip>

set -euo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

info()  { echo -e "${GREEN}✓${NC} $*"; }
warn()  { echo -e "${YELLOW}⚠${NC} $*"; }
error() { echo -e "${RED}✗${NC} $*" >&2; }
step()  { echo -e "\n${BOLD}── $* ──${NC}"; }

HOMELAB_DIR="${HOMELAB_DIR:-$HOME/homelab}"
BACKUP_DIR="$HOMELAB_DIR/platform/backup"

if [ $# -lt 1 ]; then
  echo "Usage: setup-backup-pi <pi-hostname-or-ip>"
  echo ""
  echo "Example:"
  echo "  setup-backup-pi 100.x.y.z          # Tailscale IP"
  echo "  setup-backup-pi backup-pi          # Tailscale hostname"
  echo "  setup-backup-pi pi@192.168.1.50    # user@ip format"
  exit 1
fi

PI_TARGET="$1"

# Parse user@host if provided
if [[ "$PI_TARGET" == *"@"* ]]; then
  PI_USER="${PI_TARGET%%@*}"
  PI_HOST="${PI_TARGET##*@}"
else
  PI_USER="pi"
  PI_HOST="$PI_TARGET"
fi

# ── Step 1: Verify connectivity ──────────────────────────────────────────────

step "Verifying connectivity to Pi"

if ! ssh -o ConnectTimeout=10 -o BatchMode=yes "${PI_USER}@${PI_HOST}" "echo ok" > /dev/null 2>&1; then
  warn "Cannot connect via SSH key. You may be prompted for password."
fi

if ! ssh -o ConnectTimeout=10 "${PI_USER}@${PI_HOST}" "echo ok" > /dev/null 2>&1; then
  error "Cannot connect to ${PI_USER}@${PI_HOST}"
  echo ""
  echo "Make sure:"
  echo "  1. The Pi is powered on and accessible"
  echo "  2. SSH is enabled on the Pi"
  echo "  3. The Pi is on your Tailscale network (run: tailscale status)"
  echo "  4. You can ping the Pi: ping $PI_HOST"
  exit 1
fi

info "Connected to ${PI_USER}@${PI_HOST}"

# ── Step 2: Check for external storage ───────────────────────────────────────

step "Checking storage on Pi"

BACKUP_PATH=""

# Check common external storage mount points
for mount_point in "/mnt/backup-drive" "/mnt/external" "/mnt/usb" "/media/${PI_USER}"; do
  if ssh "${PI_USER}@${PI_HOST}" "[ -d '$mount_point' ] && mountpoint -q '$mount_point' 2>/dev/null"; then
    BACKUP_PATH="$mount_point/homelab-backups"
    info "Found external storage at: $mount_point"
    break
  fi
done

# Fall back to home directory if no external storage
if [ -z "$BACKUP_PATH" ]; then
  warn "No external storage found. Using home directory."
  warn "For production use, attach an external drive to the Pi."
  BACKUP_PATH="/home/${PI_USER}/homelab-backups"
fi

echo ""
echo "Backup repository will be created at: $BACKUP_PATH"
read -p "Continue? (y/N) " -n 1 -r
echo
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
  echo "Aborted."
  exit 0
fi

# ── Step 3: Install Restic on Pi ─────────────────────────────────────────────

step "Installing Restic on Pi"

ssh "${PI_USER}@${PI_HOST}" bash << 'REMOTE_SCRIPT'
set -e

# Check if restic is already installed
if command -v restic &> /dev/null; then
  echo "Restic already installed: $(restic version)"
  exit 0
fi

# Install via apt (Raspberry Pi OS / Debian)
if command -v apt-get &> /dev/null; then
  sudo apt-get update
  sudo apt-get install -y restic
  echo "Restic installed: $(restic version)"
  exit 0
fi

echo "ERROR: Could not install restic. Please install manually."
exit 1
REMOTE_SCRIPT

info "Restic installed on Pi"

# ── Step 4: Create backup directory ──────────────────────────────────────────

step "Creating backup directory on Pi"

ssh "${PI_USER}@${PI_HOST}" bash << REMOTE_SCRIPT
set -e
mkdir -p "$BACKUP_PATH"
chmod 700 "$BACKUP_PATH"
echo "Backup directory created: $BACKUP_PATH"
REMOTE_SCRIPT

info "Backup directory ready: $BACKUP_PATH"

# ── Step 5: Setup SSH key authentication ─────────────────────────────────────

step "Setting up SSH key authentication"

LOCAL_KEY="$HOME/.ssh/id_ed25519"
if [ ! -f "$LOCAL_KEY" ]; then
  LOCAL_KEY="$HOME/.ssh/id_rsa"
fi

if [ ! -f "$LOCAL_KEY" ]; then
  info "Generating SSH key..."
  ssh-keygen -t ed25519 -f "$HOME/.ssh/id_ed25519" -N "" -C "homelab-backup"
  LOCAL_KEY="$HOME/.ssh/id_ed25519"
fi

# Copy key to Pi
if ! ssh -o BatchMode=yes "${PI_USER}@${PI_HOST}" "echo ok" > /dev/null 2>&1; then
  info "Copying SSH key to Pi..."
  ssh-copy-id -i "$LOCAL_KEY" "${PI_USER}@${PI_HOST}"
fi

info "SSH key authentication configured"

# ── Step 6: Generate repository password ─────────────────────────────────────

step "Configuring Restic repository"

mkdir -p "$BACKUP_DIR"

# Generate password if not already set
if [ -f "$BACKUP_DIR/.env" ] && grep -q "^RESTIC_PASSWORD=" "$BACKUP_DIR/.env"; then
  info "Using existing RESTIC_PASSWORD from .env"
  source "$BACKUP_DIR/.env"
else
  RESTIC_PASSWORD=$(openssl rand -hex 32)
  info "Generated new repository password"
fi

# ── Step 7: Initialize Restic repository ─────────────────────────────────────

step "Initializing Restic repository"

export RESTIC_REPOSITORY="sftp:${PI_USER}@${PI_HOST}:${BACKUP_PATH}"
export RESTIC_PASSWORD

# Check if already initialized
if restic snapshots > /dev/null 2>&1; then
  info "Repository already initialized"
else
  info "Initializing new repository..."
  restic init
  info "Repository initialized"
fi

# ── Step 8: Save configuration ───────────────────────────────────────────────

step "Saving configuration"

cat > "$BACKUP_DIR/.env" << EOF
# Backup Configuration — Generated $(date '+%Y-%m-%d %H:%M')
#
# SECURITY: This file contains the backup repository password.
# - Keep this file secure (mode 600)
# - Store a copy of RESTIC_PASSWORD offline (password manager, safe)
# - If you lose this password, backups cannot be decrypted

# Primary repository (Raspberry Pi via Tailscale)
RESTIC_REPOSITORY=sftp:${PI_USER}@${PI_HOST}:${BACKUP_PATH}

# Repository password — CRITICAL: Store this securely offline
RESTIC_PASSWORD=${RESTIC_PASSWORD}

# Offsite Pi connection details
BACKUP_PI_HOST=${PI_HOST}
BACKUP_PI_USER=${PI_USER}
BACKUP_PI_PATH=${BACKUP_PATH}

# Retention policy
RETENTION_DAILY=14
RETENTION_WEEKLY=8
RETENTION_MONTHLY=6
RETENTION_YEARLY=1

# Optional: Healthchecks.io ping URL for monitoring
# HEALTHCHECK_URL=https://hc-ping.com/<your-uuid>
EOF

chmod 600 "$BACKUP_DIR/.env"

info "Configuration saved to: $BACKUP_DIR/.env"

# ── Step 9: Test backup ──────────────────────────────────────────────────────

step "Testing backup"

# Create a test file
TEST_FILE=$(mktemp)
echo "Backup test $(date)" > "$TEST_FILE"

restic backup "$TEST_FILE" --tag "test" > /dev/null 2>&1
rm "$TEST_FILE"

info "Test backup successful"

# Verify snapshots
echo ""
restic snapshots

# ── Output ───────────────────────────────────────────────────────────────────

echo ""
echo -e "${BOLD}╔══════════════════════════════════════════════════════════════╗${NC}"
echo -e "${BOLD}║           Backup Pi Setup Complete                            ║${NC}"
echo -e "${BOLD}╚══════════════════════════════════════════════════════════════╝${NC}"
echo ""
echo -e "${BOLD}Repository:${NC} sftp:${PI_USER}@${PI_HOST}:${BACKUP_PATH}"
echo -e "${BOLD}Password:${NC} Saved in $BACKUP_DIR/.env"
echo ""
echo -e "${YELLOW}CRITICAL: Store the backup password securely offline!${NC}"
echo "If you lose this password, your backups cannot be decrypted."
echo ""
echo -e "${BOLD}Run your first full backup:${NC}"
echo "  scripts/backup-all"
echo ""
echo -e "${BOLD}Schedule daily backups:${NC}"
echo "  scripts/setup-backup-schedule"
echo ""
echo -e "${BOLD}Check repository status:${NC}"
echo "  source platform/backup/.env && restic snapshots"
echo ""
