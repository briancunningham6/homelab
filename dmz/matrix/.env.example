# Matrix (Conduit) Configuration
# Copy to .env and customize for your deployment
# Documentation: https://docs.conduit.rs/configuration.html

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Your Matrix server domain - this is your public identity
# Users will be @user:matrix.yourdomain.com
# IMPORTANT: Cannot be changed after initial setup without losing all data
CONDUIT_SERVER_NAME=matrix.yourdomain.com

# =============================================================================
# VERSION PINNING
# =============================================================================

# Conduit version - check https://hub.docker.com/r/matrixconduit/matrix-conduit/tags
CONDUIT_VERSION=v0.8.0

# Element Web version (if enabled) - check https://hub.docker.com/r/vectorim/element-web/tags
# ELEMENT_VERSION=v1.11.55

# =============================================================================
# REGISTRATION & FEDERATION
# =============================================================================

# Allow new user registration
# Set to true initially to create your admin account, then set to false
# Users can still be invited to rooms even when registration is disabled
CONDUIT_ALLOW_REGISTRATION=false

# Enable federation with other Matrix servers
# Set to false for private family-only chat (no external communication)
# Set to true to participate in the wider Matrix network
CONDUIT_ALLOW_FEDERATION=true

# =============================================================================
# DATABASE
# =============================================================================

# Database backend: rocksdb (recommended) or sqlite
CONDUIT_DATABASE_BACKEND=rocksdb

# =============================================================================
# PERFORMANCE LIMITS
# =============================================================================

# Maximum upload size in bytes (20MB default)
CONDUIT_MAX_REQUEST_SIZE=20000000

# Maximum concurrent requests
CONDUIT_MAX_CONCURRENT_REQUESTS=100

# =============================================================================
# TURN SERVER (Voice/Video Calls)
# =============================================================================

# TURN server is required for voice/video calls
# You can self-host Coturn or use a third-party service
# Uncomment and configure if you want call functionality

# CONDUIT_TURN_URIS=["turn:turn.yourdomain.com:3478?transport=udp","turn:turn.yourdomain.com:3478?transport=tcp"]
# CONDUIT_TURN_SECRET=your-turn-shared-secret

# =============================================================================
# AUTHENTIK OIDC (Optional)
# =============================================================================

# Conduit supports OIDC for authentication
# Configure these to use Authentik SSO instead of local passwords
# Requires Authentik accessible via Tailscale from the DMZ Pi

# CONDUIT_OIDC_ENABLED=true
# CONDUIT_OIDC_ISSUER=https://login.home/application/o/matrix/
# CONDUIT_OIDC_CLIENT_ID=matrix
# CONDUIT_OIDC_CLIENT_SECRET=your-client-secret
