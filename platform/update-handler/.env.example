# Update Handler Configuration

# Path to homelab root directory
HOMELAB_ROOT=/Users/user/dev/homelab

# Database path (inside container)
DB_PATH=/app/data/updates.db

# HTTP server port (internal only, accessed via Caddy)
PORT=8080

# Notes:
# - No secrets required for basic operation
# - Webhook endpoint: http://update-handler:8080/webhook
# - Dashboard accessed via: http://updates.home (Authentik admin-only)
# - Update approval triggers scripts/app-update with AUTO_APPROVE=true
