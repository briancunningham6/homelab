# Authentik Configuration
# =========================

# Secret key — generate with: openssl rand -base64 60
AUTHENTIK_SECRET_KEY=

# PostgreSQL credentials
# Generate password with: openssl rand -base64 32
POSTGRES_DB=authentik
POSTGRES_USER=authentik
POSTGRES_PASSWORD=

# Authentik database connection (must match PostgreSQL credentials above)
AUTHENTIK_POSTGRESQL__HOST=authentik-db
AUTHENTIK_POSTGRESQL__PORT=5432
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=

# Redis connection
AUTHENTIK_REDIS__HOST=authentik-redis
AUTHENTIK_REDIS__PORT=6379

# Bootstrap password for initial akadmin account
# Set on FIRST RUN ONLY, then comment out or remove
AUTHENTIK_BOOTSTRAP_PASSWORD=

# Bootstrap API token — used by scripts/setup-authentik-immich for automated setup
# Generate with: openssl rand -hex 32
# Comment out after initial setup is complete
AUTHENTIK_BOOTSTRAP_TOKEN=

# Optional: email configuration for notifications
# AUTHENTIK_EMAIL__HOST=
# AUTHENTIK_EMAIL__PORT=587
# AUTHENTIK_EMAIL__USERNAME=
# AUTHENTIK_EMAIL__PASSWORD=
# AUTHENTIK_EMAIL__USE_TLS=true
# AUTHENTIK_EMAIL__FROM=homelab@example.com
