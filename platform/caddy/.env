# Caddy Configuration
# No secrets required for local-only deployment.
# Caddy automatically handles TLS for internal hostnames.
#
# If using public ACME (not recommended for this setup):
# ACME_EMAIL=admin@example.com

# ── Shared secrets for forward-auth apps ────────────────────────────────────
# CP_SECRET: injected as X-CP-Secret header to Copyparty, proving that the
# X-authentik-username header was set by this proxy (not spoofed by a client).
# Must match CP_SECRET in apps/copyparty/.env.
# Generate: openssl rand -hex 32
CP_SECRET=3458b5e7994f7da2bd641db6c90a3d4594d413f720e1b03a938c0bacdb7db816
