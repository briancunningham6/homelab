# Homelab Platform — Caddy Reverse Proxy Configuration
#
# Each service gets a local hostname routed to its internal Docker address.
# Services must be on the caddy-net Docker network to be reachable.
#
# To add a new service:
# 1. Add a block below with http://<service>.home
# 2. Set reverse_proxy to the container name and port
# 3. Reload Caddy: docker exec caddy caddy reload --config /etc/caddy/Caddyfile
# 4. Ensure the target container joins caddy-net

{
    # Disable automatic HTTPS — this is a local-only deployment
    auto_https off
}

# --- Platform Services ---

http://dockge.home {
    reverse_proxy dockge:5001 {
        header_up X-Real-IP {remote_host}
    }
}

http://home.home {
    reverse_proxy homepage:3000 {
        header_up X-Real-IP {remote_host}
    }
}

http://status.home {
    reverse_proxy uptime-kuma:3001 {
        header_up X-Real-IP {remote_host}
    }
}

http://login.home {
    reverse_proxy authentik-server:9000 {
        header_up X-Real-IP {remote_host}
    }
}

http://backup.home {
    # Admin-only: Requires Authentik authentication (homelab-admin group)
    forward_auth authentik-server:9000 {
        uri /outpost.goauthentik.io/auth/caddy
        copy_headers X-authentik-username X-authentik-groups X-authentik-uid X-authentik-email X-authentik-name
        trusted_proxies private_ranges
    }

    reverse_proxy backrest:9898 {
        header_up X-Real-IP {remote_host}
    }
}

# --- Applications ---

http://copyparty.home {
    # Authenticate via Authentik forward-auth.
    # Unauthenticated users are redirected to login.home.
    # After auth, Caddy copies the user/group headers to Copyparty.
    forward_auth authentik-server:9000 {
        uri /outpost.goauthentik.io/auth/caddy
        copy_headers X-authentik-username X-authentik-groups X-authentik-uid X-authentik-email X-authentik-name
        trusted_proxies private_ranges
    }

    reverse_proxy copyparty:3923 {
        header_up X-Real-IP {remote_host}
        # Inject shared secret so Copyparty can verify headers aren't spoofed by clients.
        # CP_SECRET must match the value in apps/copyparty/.env (idp-h-key in copyparty.conf).
        header_up X-CP-Secret {env.CP_SECRET}
    }
}

http://immich.home, http://192.168.0.199, http://100.73.223.8 {
    reverse_proxy immich-server:2283 {
        header_up X-Real-IP {remote_host}
    }
}

# --- AI ---

http://openclaw.home {
    # OpenClaw runs natively on the host (not in Docker)
    reverse_proxy 127.0.0.1:18789 {
        header_up X-Real-IP {remote_host}
    }
}

# --- Authentik Forward Auth (for apps that need SSO protection) ---
# Uncomment and import in app blocks that need Authentik gating:
#
# (authentik) {
#     forward_auth authentik-server:9000 {
#         uri /outpost.goauthentik.io/auth/caddy
#         copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid
#         trusted_proxies private_ranges
#     }
# }
#
# Then add to any protected site block:
#     import authentik
