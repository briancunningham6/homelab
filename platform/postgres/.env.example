# Shared PostgreSQL — Platform Database Service
# Copy to .env and fill in values before first run.

# Admin credentials (for database/user management)
# Generate with: openssl rand -hex 32
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=

# Per-app credentials are stored in each app's .env, not here.
# This service only needs the admin password for initial setup and maintenance.
