# Backup Configuration
# Copy to .env and fill in values

# ── Restic Repository Configuration ──────────────────────────────────────────
# Primary backup target (local or remote)
# Examples:
#   Local:  /path/to/backup/repo
#   SFTP:   sftp:user@host:/path/to/repo
#   S3/B2:  s3:s3.amazonaws.com/bucket_name
#   REST:   rest:http://host:8000/

# Primary repository (required) - typically the offsite Pi
RESTIC_REPOSITORY=sftp:pi@<tailscale-ip>:/backups/homelab

# Repository password (required)
# Generate: openssl rand -hex 32
RESTIC_PASSWORD=changeme

# ── Secondary Repository (Optional) ──────────────────────────────────────────
# Cloud backup target (Backblaze B2, S3, etc.)
# RESTIC_REPOSITORY_SECONDARY=b2:<bucket-name>:homelab
# B2_ACCOUNT_ID=<your-account-id>
# B2_ACCOUNT_KEY=<your-account-key>

# ── Offsite Pi Configuration ─────────────────────────────────────────────────
# SSH connection details for the backup target Pi
BACKUP_PI_HOST=<tailscale-ip-or-hostname>
BACKUP_PI_USER=pi
BACKUP_PI_PATH=/backups/homelab

# ── Retention Policy ─────────────────────────────────────────────────────────
# How long to keep snapshots (restic forget flags)
RETENTION_DAILY=14
RETENTION_WEEKLY=8
RETENTION_MONTHLY=6
RETENTION_YEARLY=1

# ── Notification (Optional) ──────────────────────────────────────────────────
# Healthchecks.io ping URL for backup monitoring
# HEALTHCHECK_URL=https://hc-ping.com/<your-uuid>

# Ntfy topic for backup notifications
# NTFY_TOPIC=homelab-backups
