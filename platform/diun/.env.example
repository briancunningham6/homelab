# Diun Configuration
# Docker Image Update Notifier

# Timezone for scheduling
TZ=America/New_York

# Log level: trace, debug, info, warn, error, fatal, panic
LOG_LEVEL=info

# Log format: true for JSON, false for text
LOG_JSON=false

# Notes:
# - Diun watches all running containers by default
# - Check interval configured in config/diun.yml (default: every 2 hours)
# - Webhooks sent to update-handler service at http://update-handler:8080/webhook
# - To exclude a container from monitoring, add label: diun.enable=false
