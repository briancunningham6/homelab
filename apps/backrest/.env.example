# Backrest Configuration
# Copy to .env and customize

# Timezone for backup scheduling
TZ=UTC

# ── Backup Target (Raspberry Pi) ─────────────────────────────────────────────
# These are used when configuring the repository in Backrest UI
# The actual connection is configured in Backrest's web interface

# Pi hostname or Tailscale IP
BACKUP_PI_HOST=100.x.y.z

# SSH user on Pi
BACKUP_PI_USER=pi

# Path on Pi where backups are stored
BACKUP_PI_PATH=/backups/homelab

# ── Notes ────────────────────────────────────────────────────────────────────
# Backrest has its own authentication (first-run setup creates admin account)
# The web UI is additionally protected by Authentik forward-auth (admin group)
#
# Repository password is configured in Backrest UI, not in this file
# Store the repository password securely in a password manager
