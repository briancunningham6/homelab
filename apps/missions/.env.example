# Missions Application Configuration

# ── Database ──────────────────────────────────────────────────────────────────
# Uses shared homelab PostgreSQL instance
POSTGRES_PASSWORD=changeme
POSTGRES_DB=homelab

# ── Encryption ────────────────────────────────────────────────────────────────
# Used to encrypt LLM API keys at rest
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=changeme-must-be-32-bytes-base64

# ── Notifications ─────────────────────────────────────────────────────────────
# Ntfy server for push notifications
NTFY_URL=http://ntfy:80
NTFY_TOPIC=missions

# ── Development ───────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=info

# ── Optional External APIs ────────────────────────────────────────────────────
# Web search (Tavily) - can also be configured in UI per mission
# TAVILY_API_KEY=tvly-xxxxx

# Notes:
# - LLM API keys (Claude, OpenAI) are configured in the web UI, not here
# - They are encrypted and stored in the database
# - The ENCRYPTION_KEY is used to encrypt/decrypt them
