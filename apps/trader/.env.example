# trader — Homelab Environment Configuration
# Copy to .env and fill in all CHANGE_ME values before starting.

# -----------------------------------------------------------------------------
# SOURCE PATH
# Absolute path to the local trader repo checkout (trader-homelab branch).
# Used by compose.yml as the Docker build context.
# -----------------------------------------------------------------------------
TRADER_SOURCE_PATH=/Users/user/dev/trader

# -----------------------------------------------------------------------------
# DATABASE
# DATABASE_HOST is always overridden to 'postgres' by compose.yml.
# Credentials must match platform/postgres/init/02-trader.sql.
# -----------------------------------------------------------------------------
DATABASE_NAME=trader_prod
DATABASE_USER=trader
DATABASE_PASSWORD=CHANGE_ME   # openssl rand -base64 32

DATABASE_POOL_SIZE=10
DATABASE_SSL=false

# -----------------------------------------------------------------------------
# PHOENIX
# PHX_HOST must match the Caddy hostname (trader.home).
# -----------------------------------------------------------------------------
PHX_HOST=trader.home
PORT=4000

# Generate with: docker run --rm hexpm/elixir:1.18.3-erlang-26.2.5-debian-bookworm-20250224-slim mix phx.gen.secret
SECRET_KEY_BASE=CHANGE_ME

# -----------------------------------------------------------------------------
# ERLANG DISTRIBUTION
# -----------------------------------------------------------------------------
RELEASE_NODE=trader
RELEASE_COOKIE=CHANGE_ME   # openssl rand -base64 32

# -----------------------------------------------------------------------------
# BINANCE API
# Required for live trading. Leave blank to run in read-only / backtest mode.
# Whitelist your Tailscale IP (not public IP) in Binance API key settings.
# -----------------------------------------------------------------------------
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
AUTO_START_TRADING=false
LOG_LEVEL=info
LOG_PATH=/app/logs/debug.log

# -----------------------------------------------------------------------------
# OPTIONAL
# Override allowed WebSocket origins (comma-separated).
# Default allows http and https on PHX_HOST.
# Set this if accessing from a Tailscale hostname as well.
# Example: PHX_CHECK_ORIGINS=https://trader.home,https://trader.ts.net
# PHX_CHECK_ORIGINS=
# ML_ENABLED=false
# ML_SERVICE_URL=http://localhost:8000
# SENTRY_DSN=
