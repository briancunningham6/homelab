# Copyparty Environment Variables
# This file is committed to git. Copy to .env and fill in actual values.

# ── Shared Auth Secret ───────────────────────────────────────────────────────
# Secret header value — Caddy sends this to Copyparty to prove that the
# X-authentik-username / X-authentik-groups headers are legitimate (not spoofed
# by a client). Must match the value in platform/caddy/.env (CP_SECRET).
# Generate: openssl rand -hex 32
CP_SECRET=changeme-generate-with-openssl-rand-hex-32
