# Jellyfin Configuration
# Copy to .env and customize

# ── User/Group IDs ───────────────────────────────────────────────────────────
# Run `id` in terminal to find your user/group IDs
PUID=1000
PGID=1000

# ── Timezone ─────────────────────────────────────────────────────────────────
TZ=UTC

# ── Media Library Paths ──────────────────────────────────────────────────────
# Paths to your media directories on the host
# These are mounted read-only into the container

# Movies library
MOVIES_PATH=/path/to/movies

# TV Shows library
TV_PATH=/path/to/tv

# Music library
MUSIC_PATH=/path/to/music

# ── Authentik SSO (configured via setup script) ─────────────────────────────
# These are used by scripts/setup-authentik-jellyfin
# The actual SSO config is done in Jellyfin's admin UI after plugin install

# Authentik API token (for setup script)
# AUTHENTIK_TOKEN=

# Authentik base URL
# AUTHENTIK_URL=http://login.home

# ── Notes ────────────────────────────────────────────────────────────────────
#
# Hardware Transcoding:
#   Docker on macOS cannot use VideoToolbox (hardware transcoding).
#   Options:
#   1. Accept software transcoding (works, uses CPU)
#   2. Install Jellyfin natively on macOS for hardware transcoding
#   3. Use direct play (no transcoding needed for compatible clients)
#
# SSO Setup:
#   1. Start Jellyfin and complete initial setup (create admin account)
#   2. Run: scripts/setup-authentik-jellyfin
#   3. Install SSO plugin in Jellyfin (Dashboard → Plugins → Repositories)
#   4. Configure SSO plugin with Authentik details
#   See README.md for detailed instructions
