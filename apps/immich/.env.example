# Immich Configuration
# See https://immich.app/docs/install/environment-variables for full reference

# Immich version — keep all services on the same tag
# Check https://github.com/immich-app/immich/releases for latest stable
IMMICH_VERSION=v2.5.6

# Upload location — where photos/videos are stored on the host
# Phase A: internal disk (default)
UPLOAD_LOCATION=./data/upload
# Phase B: external SSD (uncomment when ready, comment out the line above)
# UPLOAD_LOCATION=/Volumes/HomelabData/immich-library

# Database credentials
# Generate with: openssl rand -base64 32
DB_DATABASE_NAME=immich
DB_USERNAME=immich
DB_PASSWORD=

# Machine learning
# Disable to save CPU/RAM on Mac mini if needed
# IMMICH_MACHINE_LEARNING_ENABLED=true
